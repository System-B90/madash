{
  "name": "madash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "next:dev": "next dev --turbopack -H 0.0.0.0",
    "dev": "docker compose --env-file .env -f deploy/docker-compose.local.yml up proxy -d && npm run next:dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "proxy:up": "docker compose --env-file .env -f deploy/docker-compose.local.yml up proxy -d",
    "docker:dev": "bash scripts/with-npm-token.sh docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml -f deploy/docker-compose.hive-local.yml up --watch --no-attach proxy",
    "docker:dev:rebuild": "bash scripts/with-npm-token.sh docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.dev.yml -f deploy/docker-compose.hive-local.yml up --watch --no-attach proxy --build",
    "docker:prod": "bash scripts/with-npm-token.sh docker compose --env-file .env -f deploy/docker-compose.yml up -d --build",
    "docker:link-hive": "python -m sb90_deploy link-hive",
    "docker:down": "docker compose --env-file .env -f deploy/docker-compose.yml down",
    "docker:nuke": "docker compose --env-file .env -f deploy/docker-compose.yml down -v",
    "session:start": "cd session-server && npm install && npm start",
    "session:dev": "cd session-server && npm run dev",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "npx playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config tests/playwright.config.ts --ui"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{json,css,md}": "prettier --write"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@mui/material-nextjs": "^9.0.0",
    "@mui/stylis-plugin-rtl": "^9.1.1",
    "@mui/x-charts": "^8.28.2",
    "@mui/x-date-pickers": "^8.4.0",
    "@system-b90/command-palette": "^0.1.0",
    "@system-b90/hive-core": "^0.3.0",
    "@system-b90/hive-nextauth": "^0.1.4",
    "@system-b90/session-ws": "^0.7.0",
    "@vercel/otel": "^1.12.0",
    "dayjs": "^1.11.13",
    "next": "^16.2.2",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "notistack": "^3.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stylis": "^4.3.6",
    "stylis-plugin-rtl": "^2.1.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@system-b90/test-kit": "^0.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stylis": "^4.2.7",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^61.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
