FROM node:22-alpine

WORKDIR /app

# Copy package files and install dependencies
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy the compiled server code or source code
COPY . .

# Assuming you are using ts-node or tsx for execution, or running compiled JS
CMD ["npx", "tsx", "src/session-server/session-server.ts"]
