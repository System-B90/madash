FROM node:22-alpine AS deps

WORKDIR /app

# GitHub Packages read token arrives as a BuildKit secret (`npm_token`), never
# as ARG/ENV, so it can't land in image config, layers or provenance.
COPY package.json package-lock.json .npmrc ./
RUN --mount=type=secret,id=npm_token     NPM_TOKEN="$(cat /run/secrets/npm_token)" npm ci --omit=dev --ignore-scripts

# Hot-reload target for `npm run docker:dev` (tsx watch, source synced by compose watch).
FROM deps AS dev
WORKDIR /app
COPY . .
ENV NODE_ENV=development
EXPOSE 28199
CMD ["npm", "run", "dev"]

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY . . 

USER node
EXPOSE 28199

CMD ["npx", "tsx", "session-server.ts"]
