# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

*.pyc

# dependencies
/node_modules
/session-server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tools.py runtime state (pid/log files for background dev processes)
/scripts/.tools/

*.tar

# Editor temporary files
*~
*.un~
*.swp
*.swo


# Playwright: saved SSO session (a credential) and run output
tests/.auth/
playwright-report/
test-results/
